# Sitio estático generado por Astro.
ErrorDocument 404 /404.html

# Los archivos de /_astro/ llevan un hash en el nombre: se pueden cachear para siempre.
<IfModule mod_headers.c>
  <FilesMatch "^.*\.[0-9a-zA-Z_-]{8,}\.(js|css|webp|avif|jpg|jpeg|png|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
