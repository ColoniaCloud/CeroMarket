---
import TarjetaProducto from "./TarjetaProducto.astro";
import { obtenerCategorias } from "../lib/categorias";
import { enlaceWhatsapp } from "../lib/ajustes";
import { textoBuscable, textoDeCategoria, type Producto } from "../lib/productos";

interface Props {
  productos: Producto[];
  categoria?: string | undefined;
}

// Las páginas /productos y /productos/[categoria] renderizan TODO el
// catálogo y ocultan lo que no corresponde. Así el filtro funciona sin
// JavaScript (son enlaces) y, con JavaScript, filtra en el lugar con una
// animación FLIP sin recargar (scripts/catalogo.ts).
const { productos, categoria } = Astro.props;

const filtros = [
  { slug: "", nombre: "Todo", href: "/productos/", total: productos.length },
  ...(await obtenerCategorias()).map(({ id: slug, data: { nombre } }) => ({
    slug,
    nombre,
    href: `/productos/${slug}/`,
    total: productos.filter((producto) => producto.data.categoria === slug).length,
  })),
];
const visibles = categoria ? filtros.find((filtro) => filtro.slug === categoria)!.total : productos.length;
const titulo = categoria ? filtros.find((filtro) => filtro.slug === categoria)!.nombre : "Productos";
---

<section data-catalogo data-categoria={categoria ?? ""} class="contenedor pt-10 pb-24 lg:pt-16">
  <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-6">
    <div>
      <h1 data-catalogo-titulo class="titular-cartel text-[clamp(3rem,8vw,6.5rem)] uppercase">{titulo}</h1>
      <p class="mt-3 text-gris">
        <span data-catalogo-total>{visibles}</span> productos. Armá tu pedido y mandalo por WhatsApp: precios y stock te los confirmamos.
      </p>
    </div>

    <div data-buscador-caja hidden class="w-full sm:w-80">
      <label for="buscador" class="sr-only">Buscar en el catálogo</label>
      <div class="relative">
        <svg class="pointer-events-none absolute top-1/2 left-3.5 -translate-y-1/2 text-gris" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>
        <input id="buscador" data-buscador type="search" placeholder="Buscar café, almendras…" autocomplete="off" class="campo pl-11" />
      </div>
    </div>
  </div>

  <nav aria-label="Categorías" class="-mx-[clamp(1rem,4vw,2.5rem)] mt-8 overflow-x-auto px-[clamp(1rem,4vw,2.5rem)] [scrollbar-width:none]">
    <ul class="flex w-max gap-2 pb-2 lg:w-auto lg:flex-wrap">
      {
        filtros.map((filtro) => (
          <li>
            <a
              href={filtro.href}
              data-filtro={filtro.slug}
              data-titulo={filtro.slug ? filtro.nombre : "Productos"}
              aria-current={(categoria ?? "") === filtro.slug ? "page" : undefined}
              class="inline-flex min-h-11 items-center gap-2 rounded-full bg-niebla px-4 text-[0.95rem] font-medium whitespace-nowrap transition-colors hover:bg-menta aria-[current=page]:bg-pizarra aria-[current=page]:text-blanco"
            >
              {filtro.nombre}
              <span class="text-sm tabular-nums opacity-60">{filtro.total}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <ul data-grilla class="mt-10 grid grid-cols-2 gap-x-4 gap-y-10 sm:grid-cols-3 sm:gap-x-6 lg:grid-cols-4 xl:grid-cols-5">
    {
      productos.map((producto, indice) => (
        <li
          data-tarjeta
          data-categoria={producto.data.categoria}
          data-texto={textoBuscable(producto)}
          data-texto-categoria={textoDeCategoria(producto)}
          class:list={{ hidden: categoria !== undefined && producto.data.categoria !== categoria }}
        >
          <TarjetaProducto producto={producto} encabezado="h2" carga={indice < 10 ? "eager" : "lazy"} />
        </li>
      ))
    }
  </ul>

  <div data-vacio hidden class="mx-auto mt-6 max-w-xl rounded-xl bg-niebla p-8 text-center">
    <p class="text-lg font-semibold">No encontramos «<span data-vacio-consulta></span>» en el catálogo.</p>
    <p class="mt-2 text-gris">El local tiene más de lo que entra en la web. Preguntanos, capaz que lo tenemos.</p>
    <a data-vacio-whatsapp href={enlaceWhatsapp()} target="_blank" rel="noopener" class="boton mt-6">Preguntar por WhatsApp</a>
  </div>
</section>

<script>
  import "../scripts/catalogo";
</script>
