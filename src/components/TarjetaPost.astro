---
import { Image } from "astro:assets";
import { fechaLegible, type Post } from "../lib/posts";

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { titulo, bajada, portada, tipo } = post.data;
const fecha = fechaLegible(post);
---

<a href={`/blog/${post.id}/`} class="group block">
  <div class="aspect-[4/3] overflow-hidden rounded-md bg-niebla">
    {
      portada && (
        <Image
          src={portada.src}
          width={portada.width}
          height={portada.height}
          alt=""
          widths={[400, 640, 900]}
          sizes="(min-width: 1024px) 31vw, (min-width: 640px) 48vw, 100vw"
          class="size-full object-cover transition-transform duration-500 ease-salida group-hover:scale-[1.04]"
        />
      )
    }
  </div>
  <p class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-gris">
    <span class="font-semibold text-pizarra">{tipo === "receta" ? "Receta" : "Nota"}</span>
    {fecha && <time datetime={post.data.fecha?.toISOString()}>{fecha}</time>}
  </p>
  <h3 class="mt-1 text-xl leading-snug font-bold group-hover:underline decoration-menta decoration-2 underline-offset-4">{titulo}</h3>
  {bajada && <p class="mt-2 line-clamp-3 text-gris">{bajada}</p>}
</a>
