---
import Base from "../layouts/Base.astro";
import FormularioWhatsapp from "../components/FormularioWhatsapp.astro";
import { ajustes, enlaceWhatsapp } from "../lib/ajustes";

const telefono = `+${ajustes.whatsapp.slice(0, 3)} ${ajustes.whatsapp.slice(3, 5)} ${ajustes.whatsapp.slice(5, 8)} ${ajustes.whatsapp.slice(8)}`;
---

<Base titulo="Contacto" descripcion={`Escribinos por WhatsApp o vení al local: ${ajustes.direccion}. ${ajustes.horario}.`}>
  <section class="contenedor pt-12 pb-20 lg:pt-16 lg:pb-28">
    <h1 class="titular-cartel text-[clamp(3.5rem,10vw,9rem)]">Contacto</h1>

    <div class="mt-12 grid items-start gap-14 lg:mt-16 lg:grid-cols-2 lg:gap-24">
      <div>
        <p class="max-w-[30ch] text-[clamp(1.4rem,2.4vw,1.9rem)] leading-snug font-semibold">
          Lo más rápido es WhatsApp. También podés venir al local o mandarnos un mail.
        </p>
        <dl class="mt-12 divide-y divide-linea border-y border-linea">
          <div class="grid gap-1 py-5 sm:grid-cols-[10rem_1fr]">
            <dt class="font-semibold">WhatsApp</dt>
            <dd><a href={enlaceWhatsapp("Hola, les escribo desde la web de CERO Market.")} target="_blank" rel="noopener" class="enlace">{telefono}</a></dd>
          </div>
          <div class="grid gap-1 py-5 sm:grid-cols-[10rem_1fr]">
            <dt class="font-semibold">Email</dt>
            <dd><a href={`mailto:${ajustes.email}`} class="enlace">{ajustes.email}</a></dd>
          </div>
          <div class="grid gap-1 py-5 sm:grid-cols-[10rem_1fr]">
            <dt class="font-semibold">El local</dt>
            <dd>
              {ajustes.direccion}
              <br />
              {ajustes.horario}
              <br />
              <a href={ajustes.mapa} target="_blank" rel="noopener" class="enlace">Cómo llegar</a>
            </dd>
          </div>
          <div class="grid gap-1 py-5 sm:grid-cols-[10rem_1fr]">
            <dt class="font-semibold">Redes</dt>
            <dd class="flex gap-5">
              <a href={ajustes.instagram} target="_blank" rel="noopener" class="enlace">Instagram</a>
              <a href={ajustes.facebook} target="_blank" rel="noopener" class="enlace">Facebook</a>
            </dd>
          </div>
        </dl>
      </div>

      <div class="rounded-xl bg-niebla p-6 sm:p-10">
        <h2 class="text-2xl font-bold">Dejanos tu mensaje</h2>
        <div class="mt-8">
          <FormularioWhatsapp id="contacto" intro="Hola, les escribo desde la web de CERO Market." etiquetaMensaje="Mensaje" />
        </div>
      </div>
    </div>
  </section>
</Base>
