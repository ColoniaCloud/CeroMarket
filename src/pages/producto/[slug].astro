---
import type { GetStaticPaths } from "astro";
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import IconoWhatsapp from "../../components/IconoWhatsapp.astro";
import { MAXIMO_GRANEL, MINIMO_GRANEL, medidaDe, OPCIONES_RAPIDAS, PASO_GRANEL, formatearCantidad } from "../../lib/granel";
import TarjetaProducto from "../../components/TarjetaProducto.astro";
import { ajustes, enlaceWhatsapp } from "../../lib/ajustes";
import {
  mensajeDeConsulta,
  obtenerProductos,
  textoDeEtiqueta,
  transicionDeFoto,
  type Producto,
} from "../../lib/productos";

export const getStaticPaths = (async () => {
  const productos = await obtenerProductos();
  return productos.map((producto) => ({
    params: { slug: producto.id },
    props: {
      producto,
      // Primero los de la misma categoría con foto: la fila de abajo se ve mejor.
      relacionados: productos
        .filter((otro) => otro.data.categoria === producto.data.categoria && otro.id !== producto.id)
        .sort((a, b) => Number(Boolean(b.data.imagen)) - Number(Boolean(a.data.imagen)))
        .slice(0, 5),
    },
  }));
}) satisfies GetStaticPaths;

interface Props {
  producto: Producto;
  relacionados: Producto[];
}

const { producto, relacionados } = Astro.props;
const { nombre, marca, descripcion, imagen, galeria, categoria, categoriaNombre, disponible, venta, unidad, precio } = producto.data;
const esGranel = venta === "granel";
const etiqueta = textoDeEtiqueta(producto);
const consulta = disponible
  ? mensajeDeConsulta(producto)
  : `Hola, ¿me avisan cuando vuelva a entrar ${nombre}?`;

const datosEstructurados = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: nombre,
  description: descripcion || undefined,
  brand: marca ? { "@type": "Brand", name: marca } : undefined,
  category: categoriaNombre,
  url: new URL(Astro.url.pathname, Astro.site).href,
};
---

<Base
  titulo={marca ? `${nombre}, ${marca}` : nombre}
  descripcion={descripcion || `${nombre} en CERO Market, supermercado a granel en Pocitos, Montevideo.`}
  imagen={imagen ?? undefined}
>
  <script is:inline slot="cabeza" type="application/ld+json" set:html={JSON.stringify(datosEstructurados)} />

  <article class="contenedor pt-6 pb-24 lg:pt-10">
    <nav aria-label="Ruta" class="text-[0.95rem] text-gris">
      <ol class="flex flex-wrap gap-x-2">
        <li><a href="/productos/" class="enlace">Productos</a></li>
        <li aria-hidden="true">/</li>
        <li><a href={`/productos/${categoria}/`} class="enlace">{categoriaNombre}</a></li>
      </ol>
    </nav>

    <div class="mt-6 grid gap-10 lg:mt-8 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] lg:gap-16">
      <div>
        <div class="aspect-square overflow-hidden rounded-lg bg-niebla">
          {
            imagen ? (
              <Image
                src={imagen.src}
                width={imagen.width}
                height={imagen.height}
                alt={nombre}
                widths={[480, 800, 1100]}
                sizes="(min-width: 1024px) 50vw, 100vw"
                loading="eager"
                fetchpriority="high"
                class="size-full object-cover"
                style={transicionDeFoto(producto)}
              />
            ) : (
              <div class="flex size-full items-center justify-center p-10 text-center" style={transicionDeFoto(producto)}>
                <span class="font-tiza text-3xl leading-snug text-pizarra/75 sm:text-4xl">{nombre}</span>
              </div>
            )
          }
        </div>
        {
          galeria.length > 0 && (
            <ul class="mt-4 grid grid-cols-3 gap-4">
              {galeria.map((foto, indice) => (
                <li class="aspect-square overflow-hidden rounded-md bg-niebla">
                  <Image src={foto.src} width={foto.width} height={foto.height} alt={`${nombre}, foto ${indice + 2}`} widths={[240, 400]} sizes="(min-width: 1024px) 16vw, 31vw" class="size-full object-cover" />
                </li>
              ))}
            </ul>
          )
        }
      </div>

      <div class="self-start lg:sticky lg:top-28">
        {marca && <p class="text-lg font-medium text-gris">{marca}</p>}
        <h1 class="titular-cartel mt-1 text-[clamp(2.75rem,6vw,5.25rem)]">{nombre}</h1>
        {etiqueta && <p class="mt-5"><span class="etiqueta-pizarra text-base">{etiqueta}</span></p>}
        {descripcion && <p class="mt-6 max-w-[52ch] text-lg">{descripcion}</p>}

        {!disponible && <p class="mt-6 font-semibold">Sin stock por ahora.</p>}

        {
          disponible && esGranel && (
            <div data-granel-ficha hidden data-unidad={unidad} data-precio={precio ?? ""} class="mt-8 max-w-md">
              <p class="font-semibold">¿Cuánto querés?</p>
              <div role="group" aria-label="Cantidades más pedidas" class="mt-3 flex flex-wrap gap-2">
                {OPCIONES_RAPIDAS.map((cantidad) => (
                  <button
                    type="button"
                    data-granel-opcion={cantidad}
                    aria-pressed="false"
                    class="min-h-11 rounded-full border-2 border-pizarra px-4 font-semibold transition-colors hover:bg-niebla aria-pressed:bg-pizarra aria-pressed:text-blanco"
                  >
                    {formatearCantidad(cantidad, unidad)}
                  </button>
                ))}
              </div>
              <div class="mt-3 flex h-12 w-fit items-center rounded-full border-2 border-pizarra">
                <button type="button" data-granel-menos aria-label={`${PASO_GRANEL} ${medidaDe(unidad)} menos`} class="flex size-11 items-center justify-center rounded-full text-xl hover:bg-niebla">−</button>
                <label for="cantidad-granel" class="sr-only">Cantidad en {medidaDe(unidad) === "ml" ? "mililitros" : "gramos"}</label>
                <input
                  id="cantidad-granel"
                  data-granel-cantidad
                  type="number"
                  inputmode="numeric"
                  min={MINIMO_GRANEL}
                  max={MAXIMO_GRANEL}
                  step={PASO_GRANEL}
                  value="250"
                  class="w-16 bg-transparent text-center text-lg font-semibold tabular-nums [appearance:textfield] [&::-webkit-inner-spin-button]:appearance-none"
                />
                <span aria-hidden="true" class="pr-1 text-sm text-gris">{medidaDe(unidad)}</span>
                <button type="button" data-granel-mas aria-label={`${PASO_GRANEL} ${medidaDe(unidad)} más`} class="flex size-11 items-center justify-center rounded-full text-xl hover:bg-niebla">+</button>
              </div>
              <p data-granel-precio aria-live="polite" class="mt-4 text-2xl font-bold tabular-nums" />
              <p class="mt-1 text-sm text-gris">
                Se pesa en el local: el importe puede variar un poco.
              </p>
              <button
                type="button"
                data-agregar={producto.id}
                data-nombre={nombre}
                data-granel
                data-unidad={unidad}
                class="boton mt-5 w-full text-lg sm:w-auto"
              >
                <span data-agregar-texto>Agregar al pedido</span>
              </button>
            </div>
          )
        }
        {
          disponible && !esGranel && (
            <div data-agregar-caja hidden class="mt-8 flex flex-wrap items-center gap-3">
              <div class="flex h-12 items-center rounded-full border-2 border-pizarra">
                <button type="button" data-restar aria-label="Uno menos" class="flex size-11 items-center justify-center rounded-full text-xl hover:bg-niebla">−</button>
                <label for="cantidad" class="sr-only">Cantidad</label>
                <input id="cantidad" data-cantidad type="number" inputmode="numeric" min="1" max="99" value="1" class="w-10 bg-transparent text-center text-lg font-semibold tabular-nums [appearance:textfield] [&::-webkit-inner-spin-button]:appearance-none" />
                <button type="button" data-sumar aria-label="Uno más" class="flex size-11 items-center justify-center rounded-full text-xl hover:bg-niebla">+</button>
              </div>
              <button type="button" data-agregar={producto.id} data-nombre={nombre} class="boton grow text-lg sm:grow-0">
                <span data-agregar-texto>Agregar al pedido</span>
              </button>
            </div>
          )
        }

        <a
          href={enlaceWhatsapp(consulta)}
          target="_blank"
          rel="noopener"
          class:list={["boton w-full text-lg sm:w-auto", disponible ? "boton-borde mt-3" : "mt-8"]}
        >
          <IconoWhatsapp tamano={22} />
          {disponible ? "Consultar por WhatsApp" : "Avisame cuando vuelva"}
        </a>

        <dl class="mt-10 grid gap-6 border-t border-linea pt-8 sm:grid-cols-2">
          <div>
            <dt class="font-semibold">Retiro en el local</dt>
            <dd class="mt-1 text-gris">
              {ajustes.direccion}. {ajustes.horario}.
              <a href={ajustes.mapa} target="_blank" rel="noopener" class="enlace mt-1 block text-pizarra">Cómo llegar</a>
            </dd>
          </div>
          <div>
            <dt class="font-semibold">Envíos</dt>
            <dd class="mt-1 text-gris">{ajustes.envios}</dd>
          </div>
        </dl>
      </div>
    </div>

    {
      relacionados.length > 0 && (
        <section aria-labelledby="relacionados" class="mt-24 border-t border-linea pt-12">
          <div class="flex flex-wrap items-baseline justify-between gap-4">
            <h2 id="relacionados" class="titular-cartel text-[clamp(2rem,4vw,3.25rem)]">
              Más en {categoriaNombre.toLowerCase()}
            </h2>
            <a href={`/productos/${categoria}/`} class="enlace font-medium">Ver toda la categoría</a>
          </div>
          <ul class="mt-8 grid grid-cols-2 gap-x-4 gap-y-10 sm:grid-cols-3 sm:gap-x-6 lg:grid-cols-5">
            {relacionados.map((otro) => (
              <li>
                <TarjetaProducto producto={otro} />
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
</Base>
