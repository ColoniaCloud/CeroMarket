---
import "../styles/global.css";
import { getImage } from "astro:assets";
import Cabecera from "../components/Cabecera.astro";
import Pie from "../components/Pie.astro";
import fotoPorDefecto from "../assets/sitio/local-gondolas.jpg";

interface Props {
  titulo?: string | undefined;
  descripcion?: string | undefined;
  imagen?: ImageMetadata | undefined;
}

const {
  titulo,
  descripcion = "Supermercado a granel en Pocitos, Montevideo. Comprá solo lo que necesitás, en tus propios envases.",
  imagen = fotoPorDefecto,
} = Astro.props;

const tituloCompleto = titulo
  ? `${titulo} · CERO Market`
  : "CERO Market · Supermercado a granel en Montevideo";
const canonica = new URL(Astro.url.pathname, Astro.site);
const imagenSocial = await getImage({ src: imagen, width: 1200, height: 630, fit: "cover", format: "jpg" });
---

<!doctype html>
<html lang="es-UY">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#79cabd" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_UY" />
    <meta property="og:site_name" content="CERO Market" />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={new URL(imagenSocial.src, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="cabeza" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a href="#contenido" class="saltar">Saltar al contenido</a>
    <Cabecera />
    <main id="contenido" class="flex-1">
      <slot />
    </main>
    <Pie />
  </body>
</html>
