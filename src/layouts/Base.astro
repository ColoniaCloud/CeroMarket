---
import "../styles/global.css";
import { getImage } from "astro:assets";
import Cabecera from "../components/Cabecera.astro";
import Pie from "../components/Pie.astro";
import fotoPorDefecto from "../assets/sitio/local-gondolas.jpg";

interface Props {
  titulo?: string | undefined;
  descripcion?: string | undefined;
  imagen?: ImageMetadata | undefined;
}

const {
  titulo,
  descripcion = "Supermercado a granel en Pocitos, Montevideo. Comprá solo lo que necesitás, en tus propios envases.",
  imagen = fotoPorDefecto,
} = Astro.props;

const tituloCompleto = titulo
  ? `${titulo} · CERO Market`
  : "CERO Market · Supermercado a granel en Montevideo";
const canonica = new URL(Astro.url.pathname, Astro.site);
const imagenSocial = await getImage({ src: imagen, width: 1200, height: 630, fit: "cover", format: "jpg" });
---

<!doctype html>
<html lang="es-UY">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#79cabd" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_UY" />
    <meta property="og:site_name" content="CERO Market" />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={new URL(imagenSocial.src, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="cabeza" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a href="#contenido" class="saltar">Saltar al contenido</a>
    <Cabecera />
    <main id="contenido" class="flex-1">
      <slot />
    </main>
    <Pie />

    <div
      data-aviso
      role="status"
      aria-live="polite"
      class="pointer-events-none invisible fixed inset-x-0 bottom-5 z-50 flex translate-y-4 justify-center px-4 opacity-0 transition duration-300 ease-salida data-[visible]:pointer-events-auto data-[visible]:visible data-[visible]:translate-y-0 data-[visible]:opacity-100"
    >
      <div class="flex max-w-full items-center gap-4 rounded-full bg-pizarra py-2.5 pr-2.5 pl-5 text-blanco shadow-xl">
        <span data-aviso-texto class="min-w-0 truncate"></span>
        <a href="/pedido/" class="shrink-0 rounded-full bg-menta px-4 py-2 text-sm font-semibold text-pizarra hover:bg-menta-clara">Ver pedido</a>
      </div>
    </div>

    <script>
      import "../scripts/pedido-global";
    </script>
  </body>
</html>
