# Clave aleatoria larga para firmar sesiones. Nunca en el repositorio.
PAYLOAD_SECRET=

# Carpeta persistente para la base SQLite y las fotos. En Hostinger tiene que
# ser una ruta absoluta FUERA de la app: cada deploy reemplaza la app entera.
PAYLOAD_DATA_DIR=./data

# Token de GitHub (fine-grained, solo el repo CeroMarket, permiso
# "Actions: write") para republicar ceromarket.com.uy al guardar cambios.
# Sin él, el panel funciona igual pero el sitio no se actualiza solo.
GITHUB_TOKEN_PUBLICAR=
