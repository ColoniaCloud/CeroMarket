# Carpeta persistente para la base SQLite, las fotos y la clave de sesiones.
# En Hostinger tiene que ser una ruta absoluta FUERA de la app: cada deploy
# reemplaza la app entera.
PAYLOAD_DATA_DIR=./data

# Opcional. Si no se define, el panel genera la clave la primera vez y la
# guarda en PAYLOAD_DATA_DIR/.secreto (ver lib/datos.ts).
PAYLOAD_SECRET=

# Token de GitHub (fine-grained, solo el repo CeroMarket, permiso
# "Actions: write") para republicar ceromarket.com.uy al guardar cambios.
# Sin él, el panel funciona igual pero el sitio no se actualiza solo.
GITHUB_TOKEN_PUBLICAR=
